<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
        "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>

    <constant name="struts.devMode" value="true"/>
    <constant name="struts.enable.DynamicMethodInvocation" value="false"/>

    <package name="myPackage" extends="struts-default">

        <default-action-ref name="index" />

        <action name="helloStruts" class="action.HelloStrutsAction">
            <result name="success">/WEB-INF/jsp/helloStruts.jsp</result>
            <result name="next">/WEB-INF/jsp/next.jsp</result>
        </action>

        <action name="user-confilm" class="action.HelloStrutsAction" method = "confilm">
            <result name="next">/WEB-INF/jsp/next.jsp</result>
        </action>
        
		<action name="shain_touroku" class="action.ShainTourokuAction">
	        <result name="input">/WEB-INF/jsp/shain_touroku.jsp</result>
	        <result name="success">/WEB-INF/jsp/complete.jsp</result>
		</action>
        
		<action name="shain_itirann" class="action.ShainItirannAction">
		    <result name="success">/WEB-INF/jsp/shain_itirann.jsp</result>
		</action>

	    <action name="shain_hensyuu" class="action.ShainHensyuuAction">
	        <result name="input">/WEB-INF/jsp/shain_hensyuu.jsp</result>
	        <result name="success" type="redirectAction">shain_itirann</result>
	    </action>
	    
	    <action name="shain_sakujyo" class="action.ShainSakujyoAction">
		    <result name="success" type="redirectAction">shain_itirann</result>
		</action>
		
		<action name="shain_pdf" class="action.ShainPdfAction">
		    <result type="stream">
		        <param name="contentType">application/pdf</param>
		        <param name="inputName">inputStream</param>
		        <param name="contentDisposition">attachment;filename="shain_list.pdf"</param>
		        <param name="bufferSize">1024</param>
		    </result>
		</action>
	    
    </package>

</struts>
